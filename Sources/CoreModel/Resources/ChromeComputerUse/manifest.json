{
  "manifest_version": 3,
  "name": "RemoteCode Computer Use",
  "version": "1.0.0",
  "description": "Let RemoteCode work in its own background tabs using this Chrome profile. Selecting a tab gives you control.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connect RemoteCode Computer Use"
  }
}
