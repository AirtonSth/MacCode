+    /// One event every 2 ms (a streaming turn). Publish → client receive.
+    @MainActor
+    func test_receipt_wsSpacedEventLatency() async throws {
+        let fixture = try makeFixture()
+        defer { fixture.server.stop() }
+        var roundP50 = Array(repeating: [Double](), count: Self.wsVariants.count)
+        var roundP95 = Array(repeating: [Double](), count: Self.wsVariants.count)
+        var pooled = Array(repeating: [Double](), count: Self.wsVariants.count)
+        var round = 0
+        for pass in 0..<6 {
+            for (index, variant) in Self.wsVariants.enumerated() {
+                variant.apply()
+                let ws = try await Self.openWS(fixture)
+                defer { ws.session.invalidateAndCancel() }
+                let latencies = try await Self.publishAndCollect(ws, count: 200, spacingMicros: 2_000, round: round)
+                round += 1
+                ws.task.cancel(with: .goingAway, reason: nil)
+                if pass >= 1 {
+                    let sorted = latencies.sorted()
+                    roundP50[index].append(Self.percentile(sorted, 0.5))
+                    roundP95[index].append(Self.percentile(sorted, 0.95))
+                    pooled[index].append(contentsOf: latencies)
+                }
+            }
+        }
+        for (index, variant) in Self.wsVariants.enumerated() {
+            Self.report("ws_spaced_2ms_x200_event_latency_pooled__\(variant.name)", pooled[index], includeSamples: false)
+            Self.report("ws_spaced_2ms_x200_round_p50__\(variant.name)", roundP50[index])
+            Self.report("ws_spaced_2ms_x200_round_p95__\(variant.name)", roundP95[index])
