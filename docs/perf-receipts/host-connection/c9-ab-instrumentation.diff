+    /// A peer that drops mid-RPC must still cancel the work and release the
+    /// socket under both watchdogs. Measures drop → socket released.
+    @MainActor
+    func test_receipt_peerDropMidRPC_releaseLatency() async throws {
+        let fixture = try makeFixture()
+        defer { fixture.server.stop() }
+        var results = Array(repeating: [Double](), count: Self.watchdogVariants.count)
+        let body = try JSONSerialization.data(withJSONObject: [
+            "jsonrpc": "2.0", "id": 1, "method": "system.ping", "params": [:] as [String: Any],
+        ])
+        for round in 0..<(2 + 7) {
+            for (index, variant) in Self.watchdogVariants.enumerated() {
+                variant.apply()
+                let baseline = fixture.server.acceptedSocketCountForTests
+                let fd = try Self.rawConnect(port: fixture.port)
+                let request = "POST /v1/rpc HTTP/1.1\r\nHost: 127.0.0.1\r\nAuthorization: Bearer \(fixture.token)\r\nContent-Type: application/json\r\nContent-Length: \(body.count)\r\n\r\n"
+                var bytes = Data(request.utf8)
+                bytes.append(body)
+                // Main is blocked for the whole sample, so the RPC is in flight
+                // when the peer drops.
+                _ = bytes.withUnsafeBytes { Darwin.write(fd, $0.baseAddress, $0.count) }
+                Thread.sleep(forTimeInterval: 0.05)
+                let t0 = DispatchTime.now()
+                Darwin.close(fd)
+                var released: Double = -1
+                while Self.ms(since: t0) < 500 {
+                    if fixture.server.acceptedSocketCountForTests <= baseline {
+                        released = Self.ms(since: t0)
+                        break
+                    }
+                    usleep(100)
+                }
+                XCTAssertGreaterThanOrEqual(released, 0, "\(variant.name): socket never released")
+                if round >= 2 { results[index].append(released) }
+                // Let the blocked RPC drain before the next sample.
+                await Task.yield()
+                try await Task.sleep(nanoseconds: 20_000_000)
+            }
+        }
+        for (index, variant) in Self.watchdogVariants.enumerated() {
+            Self.report("peer_drop_mid_rpc_release_ms__\(variant.name)", results[index])
+        }
+    }
