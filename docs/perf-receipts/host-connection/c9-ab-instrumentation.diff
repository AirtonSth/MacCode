+
+    /// 150 events published back to back (a flushed coalesce window or a
+    /// replay slice, about 75 KB; small enough that the outbound budget does
+    /// not shed). Time from the first publish to the last receive, and the
+    /// process CPU spent (host and in-process client together).
+    @MainActor
+    func test_receipt_wsBurstThroughput() async throws {
+        let fixture = try makeFixture()
+        defer { fixture.server.stop() }
+        var elapsed = Array(repeating: [Double](), count: Self.wsVariants.count)
+        var cpu = Array(repeating: [Double](), count: Self.wsVariants.count)
+        var round = 1_000
+        for pass in 0..<12 {
+            for (index, variant) in Self.wsVariants.enumerated() {
+                variant.apply()
+                let ws = try await Self.openWS(fixture)
+                defer { ws.session.invalidateAndCancel() }
+                try await Task.sleep(nanoseconds: 20_000_000)
+                let r0 = Self.usage()
+                let t0 = DispatchTime.now()
+                let got = try await Self.publishAndCollect(ws, count: 150, spacingMicros: 0, round: round)
+                let ms = Self.ms(since: t0)
+                let r1 = Self.usage()
+                round += 1
+                ws.task.cancel(with: .goingAway, reason: nil)
+                if pass >= 2, got.count == 150 {
+                    elapsed[index].append(ms)
+                    cpu[index].append(r1.cpuMs - r0.cpuMs)
+                }
+            }
+        }
+        for (index, variant) in Self.wsVariants.enumerated() {
+            Self.report("ws_burst_150_events_time_to_last_ms__\(variant.name)", elapsed[index])
+            Self.report("ws_burst_150_events_process_cpu_ms__\(variant.name)", cpu[index])
+        }
+    }
+
+    // MARK: - Helpers
+
+    private struct WS {
+        let session: URLSession
+        let task: URLSessionWebSocketTask
+    }
+
+    private static func openWS(_ fixture: Fixture) async throws -> WS {
+        var request = URLRequest(url: URL(string: "ws://127.0.0.1:\(fixture.port)/v1/ws")!)
+        request.setValue("Bearer \(fixture.token)", forHTTPHeaderField: "Authorization")
+        let session = URLSession(configuration: .ephemeral)
+        let task = session.webSocketTask(with: request)
+        task.maximumMessageSize = 8 * 1_024 * 1_024
+        task.resume()
+        // Welcome frame first.
+        _ = try await task.receive()
+        return WS(session: session, task: task)
+    }
+
+    private final class Published: @unchecked Sendable {
+        private let lock = NSLock()
+        private var stamps: [Int: UInt64] = [:]
+        func set(_ index: Int, _ ns: UInt64) { lock.lock(); stamps[index] = ns; lock.unlock() }
+        func get(_ index: Int) -> UInt64? { lock.lock(); defer { lock.unlock() }; return stamps[index] }
+    }
+
+    /// Publishes `count` state events on a background thread and returns the
+    /// per-event publish→receive latency in milliseconds.
+    private static func publishAndCollect(
+        _ ws: WS,
+        count: Int,
+        spacingMicros: UInt32,
+        round: Int
+    ) async throws -> [Double] {
+        let marker = "c9r\(round)-"
+        let stamps = Published()
+        let filler = String(repeating: "The change is in place and the tests pass. ", count: 4)
+        Thread.detachNewThread {
+            for index in 0..<count {
+                let now = DispatchTime.now().uptimeNanoseconds
+                stamps.set(index, now)
+                EventBus.shared.publish(kind: .agentItemCompleted, payload: .object([
+                    "thread_id": .string("c9-receipt"),
+                    "item_id": .string("\(marker)\(index)"),
+                    "kind": .string("assistant_message"),
+                    "text": .string(filler),
+                ]))
+                if spacingMicros > 0 { usleep(spacingMicros) }
+            }
+        }
+        // A stream that never delivers must fail the scenario, not hang the run.
+        let deadline = Task {
+            try await Task.sleep(nanoseconds: 5_000_000_000)
+            ws.task.cancel(with: .goingAway, reason: nil)
+        }
+        defer { deadline.cancel() }
+        var latencies: [Double] = []
+        latencies.reserveCapacity(count)
+        var seen = 0
+        var otherFrames: [String] = []
+        while seen < count {
+            guard let message = try? await ws.task.receive() else {
+                FileHandle.standardError.write(Data(
+                    "INCOMPLETE round=\(round) seen=\(seen)/\(count) other_frames=\(otherFrames.suffix(5))\n".utf8
+                ))
+                break
+            }
+            let received = DispatchTime.now().uptimeNanoseconds
+            let text: String
+            switch message {
+            case .data(let value): text = String(decoding: value, as: UTF8.self)
+            case .string(let value): text = value
+            @unknown default: text = ""
+            }
+            // A connect-time `baselineRequired` (no cursor, replayTruncated)
+            // is advisory here: the stream keeps delivering, and only event
+            // latency is measured. Skip it rather than counting it.
+            if !text.contains(marker) { otherFrames.append(String(text.prefix(160))) }
+            if text.contains("\"type\":\"baselineRequired\"") { continue }
+            var search = text[...]
+            while let range = search.range(of: marker) {
+                let digits = search[range.upperBound...].prefix { $0.isNumber }
+                if let index = Int(digits), let sent = stamps.get(index) {
+                    latencies.append(Double(received &- sent) / 1_000_000)
+                    seen += 1
+                }
+                search = search[range.upperBound...]
+            }
+        }
+        return latencies
+    }
+
+    private static func usage() -> (cpuMs: Double, switches: Double) {
+        var r = rusage()
+        getrusage(RUSAGE_SELF, &r)
+        let user = Double(r.ru_utime.tv_sec) * 1_000 + Double(r.ru_utime.tv_usec) / 1_000
+        let system = Double(r.ru_stime.tv_sec) * 1_000 + Double(r.ru_stime.tv_usec) / 1_000
+        return (user + system, Double(r.ru_nvcsw + r.ru_nivcsw))
+    }
+
+    private static func ms(since start: DispatchTime) -> Double {
+        Double(DispatchTime.now().uptimeNanoseconds &- start.uptimeNanoseconds) / 1_000_000
+    }
+
+    private static func rawConnect(port: UInt16) throws -> Int32 {
+        let fd = socket(AF_INET, SOCK_STREAM, 0)
+        var address = sockaddr_in()
+        address.sin_family = sa_family_t(AF_INET)
+        address.sin_port = port.bigEndian
+        address.sin_addr.s_addr = inet_addr("127.0.0.1")
+        let result = withUnsafePointer(to: &address) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                Darwin.connect(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
+            }
+        }
+        guard result == 0 else { throw NSError(domain: "receipt", code: Int(errno)) }
+        return fd
+    }
+
+    private static func rpc(
+        _ fixture: Fixture,
+        method: String,
+        params: [String: Any] = [:],
+        session: URLSession = .shared
+    ) async throws -> Double {
+        var request = URLRequest(url: URL(string: "http://127.0.0.1:\(fixture.port)/v1/rpc")!)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("Bearer \(fixture.token)", forHTTPHeaderField: "Authorization")
+        request.httpBody = try JSONSerialization.data(withJSONObject: [
+            "jsonrpc": "2.0", "id": 1, "method": method, "params": params,
+        ])
+        let t0 = DispatchTime.now()
+        let (data, response) = try await session.data(for: request)
+        let latency = ms(since: t0)
+        XCTAssertEqual((response as? HTTPURLResponse)?.statusCode, 200)
+        let object = try JSONSerialization.jsonObject(with: data) as? [String: Any]
+        XCTAssertNil(object?["error"], "\(method) failed: \(String(decoding: data, as: UTF8.self).prefix(300))")
+        return latency
+    }
+
+    private static func rpcBatch(_ fixture: Fixture, _ batch: [[String: Any]]) async throws -> Double {
+        var request = URLRequest(url: URL(string: "http://127.0.0.1:\(fixture.port)/v1/rpc")!)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("Bearer \(fixture.token)", forHTTPHeaderField: "Authorization")
+        request.httpBody = try JSONSerialization.data(withJSONObject: batch)
+        let t0 = DispatchTime.now()
+        let (data, response) = try await URLSession.shared.data(for: request)
+        let latency = ms(since: t0)
+        XCTAssertEqual((response as? HTTPURLResponse)?.statusCode, 200)
+        let items = try XCTUnwrap(try JSONSerialization.jsonObject(with: data) as? [[String: Any]])
+        XCTAssertEqual(items.count, batch.count)
+        for (index, item) in items.enumerated() {
+            XCTAssertEqual((item["id"] as? NSNumber)?.intValue, (batch[index]["id"] as? Int), "batch order")
+            XCTAssertNil(item["error"], "batch item failed: \(item)")
+        }
+        return latency
+    }
+
+    private static func percentile(_ sorted: [Double], _ p: Double) -> Double {
+        guard !sorted.isEmpty else { return 0 }
+        let index = min(sorted.count - 1, Int((p * Double(sorted.count - 1)).rounded()))
+        return sorted[index]
+    }
+
+    private static func report(_ name: String, _ samples: [Double], includeSamples: Bool = true) {
+        let sorted = samples.sorted()
+        var payload: [String: Any] = [
+            "scenario": name,
+            "n": samples.count,
+            "p50_ms": (percentile(sorted, 0.5) * 1000).rounded() / 1000,
+            "p95_ms": (percentile(sorted, 0.95) * 1000).rounded() / 1000,
+            "max_ms": ((sorted.last ?? 0) * 1000).rounded() / 1000,
+        ]
+        if includeSamples { payload["samples_ms"] = samples.map { ($0 * 1000).rounded() / 1000 } }
+        let data = (try? JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys])) ?? Data()
+        // Unbuffered: a killed run must not lose receipts already taken.
+        FileHandle.standardError.write(Data("RECEIPT \(String(decoding: data, as: UTF8.self))\n".utf8))
+    }
+}
