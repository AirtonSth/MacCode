+import Foundation
+
+/// TEMPORARY C9 measurement switches. Lets the receipt harness interleave the
+/// old and new transport paths sample by sample in one process. Removed before
+/// commit; only the paths with a winning receipt remain.
+enum C9TransportTuning {
+    nonisolated(unsafe) static var noDelay = false
+    nonisolated(unsafe) static var writev = false
+    nonisolated(unsafe) static var parallelBatch = false
+    nonisolated(unsafe) static var sourceWatchdog = false
+    nonisolated(unsafe) static var wsGather = false
+}
