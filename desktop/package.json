{
  "name": "remotecode-electrobun",
  "version": "1.0.0",
  "description": "Electrobun app with React + Vite",
	"scripts": {
		"start": "vite build && electrobun dev",
    "build:vite": "vite build",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "bun run scripts/hmr.mjs",
		"build:canary": "vite build && electrobun build --env=canary",
		"test:backend": "bun test ./src/bun/server --pattern '.*\\.test\\.ts$'",
		"typecheck": "bun run tsc --noEmit",
		"lint": "bunx eslint --fix ."
	},
  "dependencies": {
    "@elysiajs/eden": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "1.14.4",
    "elysia": "^1.4.9",
    "framer-motion": "^11.15.0",
    "drizzle-orm": "^0.39.3",
    "drizzle-kit": "^0.30.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "8.57.1",
    "eslint-config-hardcore": "^49.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "5.4.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bunx eslint --fix"
    ]
  }
}
