{
  "name": "remotecode-electrobun",
  "version": "1.0.0",
  "description": "Electrobun app with React + Vite",
  "scripts": {
    "start": "vite build && electrobun dev",
    "build:vite": "vite build",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "bun run scripts/hmr.mjs",
    "build:canary": "vite build && electrobun build --env=canary",
    "e2e:serve": "bunx vite e2e/frontend --host 127.0.0.1 --port 4173 --strictPort",
    "e2e:run": "bunx wdio run wdio.conf.mjs",
    "e2e:run:frontend": "bunx wdio run wdio.conf.mjs --spec ./e2e/frontend/**/*.e2e.mjs",
    "e2e:run:playwright": "bunx playwright test -c e2e/playwright/playwright.config.mjs",
    "mcp:playwright-electron": "bun run ./playwright-e2e/playwright-mcp-electron.ts",
    "automation:cdp-screenshot": "bun run ./playwright-e2e/cdp-screenshot.ts",
    "test:e2e": "bunx concurrently \"bun run e2e:serve\" \"bunx wait-on tcp:127.0.0.1:4173 && bun run e2e:run\" --kill-others --success first",
    "test:e2e:frontend": "bunx concurrently \"bun run e2e:serve\" \"bunx wait-on tcp:127.0.0.1:4173 && bun run e2e:run:frontend\" --kill-others --success first",
    "test:backend": "bun test ./src/bun/server --pattern '.*\\.test\\.ts$'",
    "typecheck": "bun run tsc --noEmit",
    "lint": "bunx eslint --fix .",
    "lint:check": "bunx eslint ."
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.7",
    "bonjour-service": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.30.4",
    "drizzle-orm": "^0.39.3",
    "electrobun": "1.14.4",
    "elysia": "^1.4.9",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/cli": "^8.46.0",
    "@wdio/local-runner": "^8.46.0",
    "@wdio/mocha-framework": "^8.46.0",
    "@wdio/spec-reporter": "^8.43.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "8.57.1",
    "eslint-config-hardcore": "^49.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "5.4.11",
    "wait-on": "^8.0.3",
    "wdio-chromedriver-service": "^8.1.1"
  }
}
