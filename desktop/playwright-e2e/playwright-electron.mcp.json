{
  "mcpServers": {
    "playwright-electron": {
      "command": "bun",
      "args": [
        "run",
        "--cwd",
        "/absolute/path/to/remotecode.io",
        "mcp:playwright-electron"
      ],
      "env": {
        "PLAYWRIGHT_MCP_PORT": "8931",
        "ELECTROBUN_EXECUTABLE_PATH": "/absolute/path/to/remotecode.io/desktop/node_modules/.bin/electrobun"
      }
    }
  }
}
