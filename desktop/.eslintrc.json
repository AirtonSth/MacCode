{
  "root": true,
  "ignorePatterns": ["bun.lock", "dist/**", "build/**", "node_modules/**", "package-lock.json", "**/node_modules/**"],
  "parserOptions": {
    "project": "./tsconfig.eslint.json",
    "projectService": true
  },
  "extends": [
    "hardcore",
    "hardcore/ts",
    "hardcore/react",
    "hardcore/react-performance",
    "hardcore/fp"
  ],
  "env": {
    "browser": true
  },
  "rules": {
    "sonarjs/no-one-iteration-loop": "off",
    "putout/putout": "off",
    "total-functions/require-strict-mode": "off",
    "@typescript-eslint/no-use-before-define": [
      "error",
      {
        "ignoreTypeReferences": true
      }
    ],
    "strict": "off",
    "@typescript-eslint/naming-convention": "off",
    "@stylistic/no-tabs": "off",
    "no-console": "off",
    "n/no-unsupported-features/node-builtins": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "ssr-friendly/no-dom-globals-in-module-scope": "off",
    "id-length": "off",
    "react/jsx-no-bind": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "import/no-unused-modules": "off",
    "import/no-anonymous-default-export": "off",
    "@shopify/prefer-class-properties": "off",
    "etc/no-implicit-any-catch": "off",
    "import/no-namespace": "off"
  },
  "overrides": [
    {
      "files": ["electrobun.config.ts", "vite.config.ts", ".eslintrc.json", "tsconfig.json", "tsconfig.eslint.json", "package.json", "bun.lock"],
      "env": {
        "browser": false,
        "node": true
      }
    },
    {
      "files": ["src/bun/**/*"],
      "extends": ["hardcore/node"],
      "env": {
        "browser": false,
        "node": true
      },
      "rules": {
        "n/no-unsupported-features/node-builtins": "off"
      }
    },
    {
      "files": ["src/bun/providers/fake-codex-provider.mjs"],
      "rules": {
        "functional/immutable-data": "off"
      }
    }
  ]
}
