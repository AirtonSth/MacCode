{
  "name": "remotecode-workspace",
  "private": true,
  "workspaces": [
    "desktop",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "./scripts/apply-expo-ui-text-timer-patch.sh && ./scripts/cleanup-stale-expo-artifacts.sh",
    "clean": "./scripts/cleanup-stale-expo-artifacts.sh",
    "prepare": "husky",
    "lint": "bun run lint:mobile && bun run lint:contracts",
    "lint:desktop": "bun run --cwd desktop lint:check",
    "lint:mobile": "bun run --cwd mobile lint",
    "lint:contracts": "bun run --cwd packages/contracts lint",
    "typecheck": "bun run typecheck:desktop && bun run typecheck:mobile && bun run typecheck:contracts",
    "typecheck:desktop": "bun run --cwd desktop typecheck",
    "typecheck:mobile": "bun run --cwd mobile typecheck",
    "typecheck:contracts": "bun run --cwd packages/contracts typecheck",
    "test:quick": "bun run test:quick:desktop",
    "test:quick:desktop": "bun run --cwd desktop test:backend",
    "start:desktop": "bun run --cwd desktop start:hmr",
    "dev:desktop": "bun run --cwd desktop dev:hmr",
    "dev:mobile": "bun run --cwd mobile start",
    "dev:mobile:ios": "cd mobile && bunx expo run:ios",
    "dev:mobile:ios-device": "cd mobile && bunx expo run:ios --device --configuration Release",
    "mcp:playwright-electron": "bun run --cwd desktop mcp:playwright-electron"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-hardcore": "^49.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "mobile/src/**/*.{ts,tsx,js,jsx}": [
      "bunx eslint --fix --max-warnings=0"
    ],
    "packages/contracts/src/**/*.{ts,tsx,js,jsx}": [
      "bunx eslint --fix --max-warnings=0"
    ]
  }
}
